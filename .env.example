# OpenTrail Configuration Example

# Python Executable (must have graphify 0.9.93 installed)
PYTHON_EXECUTABLE=D:\python.exe

# Google GenAI / Gemma 4 Credentials
# Leave empty to run with deterministic offline AST grounding
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
FALLBACK_MODEL=gemini-3.8-flash

# Frontend & CORS
FRONTEND_ORIGIN=http://localhost:5173

# Resource & Protection Limits
MAX_REPOSITORY_SIZE_MB=50
MAX_REPOSITORY_FILES=1000
MAX_GRAPH_NODES=3000
JOB_TIMEOUT_SECONDS=120

# Ephemeral Storage Directory
STORAGE_DIR=.storage
